[
    {
        "type": "readers.copc",
        "filename": "{{ data_dir }}/normalised-lidar-sites/{{ site }}.copc.laz",
        "polygon": "{{ polygon_wkt }}"
    },
    // Remove noise and other points
    { "type": "filters.range", "limits": "Classification[0:5]" },
    // Write as COPC LAZ
    {
        "type": "writers.copc",
        "filename": "{{ data_dir }}/lidar-plots-copc/{{ site_plot_id }}.copc.laz",
        "forward": "header,scale,offset",
        "extra_dims": "all"
    }
]
