// Produce a set of rasters for sites:
// - DSM: maximum point elevation (Z)
// - DEM: minimum ground point elevation (Z)
// - CHM: maximum first return height above ground
// - Pulse Density: count of first returns
// - Point Density: count of all returns
[
    // Read in laz file
    {
        "type": "readers.copc",
        "filename": "{{ data_dir }}/sites/MGA2020/lidar/{{ site }}.copc.laz"
    },
    // Filter out noise
    {
        "type": "filters.range",
        "limits": "Classification[0:5]"
    },
    // Write DSM raster as max point
    // Method should be same as lidR p2r()
    {
        "type": "writers.gdal",
        "filename": "{{ data_dir }}/sites/MGA2020/raster/{{ site }}_dsm.tif",
        "resolution": 1,
        "output_type": "max"
    },
    // Write DEM raster as min ground point
    // No equivalent in lidR?
    // Will have areas of nodata
    {
        "type": "writers.gdal",
        "filename": "{{ data_dir }}/sites/MGA2020/raster/{{ site }}_dem.tif",
        "resolution": 1,
        "output_type": "min",
        "where": "Classification == 2"
    },
    // Write CHM using max HeightAboveGround
    // This will be similar to lidR p2r again
    // Filter to first returns only
    {
        "type": "writers.gdal",
        "filename": "{{ data_dir }}/sites/MGA2020/raster/{{ site }}_chm.tif",
        "resolution": 1,
        "output_type": "max",
        "where": "ReturnNumber == 1",
        "dimension": "HeightAboveGround"
    },
    // Pulse Density
    {
        "type": "writers.gdal",
        "filename": "{{ data_dir }}/sites/MGA2020/raster/{{ site }}_pulsedensity.tif",
        "resolution": 1,
        "output_type": "count",
        "where": "ReturnNumber == 1",
        "binmode": true,
        "nodata": 0
    },
    // Point Density
    {
        "type": "writers.gdal",
        "filename": "{{ data_dir }}/sites/MGA2020/raster/{{ site }}_pointdensity.tif",
        "resolution": 1,
        "output_type": "count",
        "binmode": true,
        "nodata": 0
    }
]
