// Prepares lidar sites by:
// - Reprojectiong to MGA2020
// - Labeling outliers
// - Calculating height above ground
// - Writing as a copc
[
    // Read in laz file
    {
        "type": "readers.las",
        "filename": "{{ data_dir }}/sites/MGA94/lidar/{{ site }}.laz"
    },
    // Reproject to MGA 2020
    {
        "type": "filters.reprojection",
        "out_srs": "EPSG:7855"
    },
    // Crop to my 12.5m buffer
    {
        "type": "filters.crop",
        "polygon": "{{ polygon_wkt }}"
    },
    // Label statistical outliers
    {
        "type": "filters.outlier",
        "method": "statistical",
        "mean_k": 6,
        "multiplier": 10
    },
    // Calculate height above ground
    {
        "type": "filters.hag_nn",
        "allow_extrapolation": false,
        "count": 1
    },
    // Write to COPC
    {
        "type": "writers.copc",
        "filename": "{{ data_dir }}/sites/MGA2020/lidar/{{ site }}.copc.laz",
        "forward": "scale,offset",
        "extra_dims": "all"
    }
]
