[
    {
        "type": "readers.copc",
        "filename": "{{ data_dir }}/sites/MGA2020/lidar/{{ site }}.copc.laz",
        "polygon": "{{ polygon_wkt }}"
    },
    // Remove noise and other points
    { "type": "filters.range", "limits": "Classification[0:5]" },
    // Write as COPC LAZ
    {
        "type": "writers.copc",
        "filename": "{{ data_dir }}/plots/MGA2020/lidar/{{ site_plot_id }}.copc.laz",
        "forward": "scale,offset",
        "extra_dims": "all"
    }
]
