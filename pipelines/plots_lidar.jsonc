[
    {
        "type": "readers.copc",
        "filename": "{{ data_dir }}/sites/lidar/{{ site }}.copc.laz",
        "polygon": "{{ polygon_wkt }}"
    },
    // Remove noise and other points
    { "type": "filters.range", "limits": "Classification[0:5]" },
    // Write as COPC LAZ
    {
        "type": "writers.copc",
        "filename": "{{ data_dir }}/plots/lidar/{{ site_plot_id }}.copc.laz",
        "forward": "scale,offset",
        "extra_dims": "all"
    },
    // Move height above ground into Z coordinate
    {
        "type": "filters.ferry",
        "dimensions": "Z => Altitude, HeightAboveGround => Z"
    },
    // Write a normalised copc as well
    {
        "type": "writers.copc",
        "filename": "{{ data_dir }}/plots/lidar-normalised/{{ site_plot_id }}.copc.laz",
        "forward": "scale,offset",
        "extra_dims": "all"
    }
]
