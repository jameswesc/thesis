library(lidR)
source("~/Code/thesis/scripts/noise-test.R")
las <- readLAS("data/sites/lidar-MGA94/AGG_O_01.laz", select = "xyzc")
sd <- sd(las$Z)
mean <- mean(las$Z)
noisey_points <- sum(las$Z > mean + 6 * sd | las$Z < mean - 6 * sd)
noisey_points <- sum(las$Z > mean + 5 * sd | las$Z < mean - 5 * sd)
noisey_points <- sum(las$Z > mean + 2 * sd | las$Z < mean - 2 * sd)
noisey_points <- sum(las$Z > mean + 6 * sd | las$Z < mean - 6 * sd)
